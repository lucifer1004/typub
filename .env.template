# =============================================================================
# typub Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual credentials.
# Variables can also be set in typub.toml using $VAR or ${VAR} syntax.

# -----------------------------------------------------------------------------
# Platform API Credentials
# -----------------------------------------------------------------------------

# Confluence
# Generate token at: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_KEY=your-api-token-here
CONFLUENCE_EMAIL=your-email@example.com

# Notion
# Create integration at: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your-integration-token-here

# Dev.to
# Generate at: https://dev.to/settings/extensions
DEVTO_API_KEY=your-api-key-here

# Hashnode
# Generate at: https://hashnode.com/settings/developer
HASHNODE_API_KEY=your-api-key-here
# Publication ID from your Hashnode blog settings
HASHNODE_PUBLICATION_ID=your-publication-id-here
# Optional: publication host for custom domains
HASHNODE_PUBLICATION_HOST=your-blog.hashnode.dev

# Ghost
# Get from Ghost Admin > Settings > Integrations > Add custom integration
GHOST_ADMIN_API_KEY=your-id:your-secret-here

# WordPress
# JWT token from WordPress JWT Auth plugin
WORDPRESS_API_KEY=your-jwt-token-here

# XiaoHongShu
# Note: XiaoHongShu adapter reads credentials from config, not env vars

# Astro
# Note: Astro adapter writes to local files, no API credentials needed

# -----------------------------------------------------------------------------
# S3 / Object Storage (for asset uploads)
# -----------------------------------------------------------------------------

# URL prefix for constructing public asset URLs
S3_URL_PREFIX=https://cdn.example.com/assets

# Primary S3 credentials (typub-specific)
S3_ACCESS_KEY_ID=your-access-key-here
S3_SECRET_ACCESS_KEY=your-secret-key-here

# AWS-compatible fallback (shared with other AWS tools)
# AWS_ACCESS_KEY_ID=your-access-key-here
# AWS_SECRET_ACCESS_KEY=your-secret-key-here

# -----------------------------------------------------------------------------
# UI / Display
# -----------------------------------------------------------------------------

# Disable colored output (any non-empty value disables colors)
# NO_COLOR=1

# Locale settings (for i18n, read in order: LC_ALL > LC_MESSAGES > LANG)
# LANG=en_US.UTF-8
